@model List<Member>
@{
    ViewData["Title"] = "Members";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Members</h1>
        <p class="text-muted mb-0">@Model.Count members registered</p>
    </div>
    @* Task 14 puts the Add a member button here *@
    <a asp-action="Create" class="btn btn-primary">Add a member</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th class="text-end" style="width:4rem">#</th>
            <th>Name</th>
            <th>Email</th>
            <th>Type</th>
            <th style="width:10rem"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model)
        {
            <tr>
                <td class="text-end">@member.MemberId</td>
                <td>@member.FullName</td>
                <td>@(member.Email ?? "—")</td>
                <td><span class="badge text-bg-secondary">@member.MemberType</span></td>
                <td class="text-end">
                    @* Task 15 puts the Edit button here *@
                    <a asp-action="Edit" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    @* Task 16 puts the Delete button here *@
                </td>
            </tr>
        }
    </tbody>
</table>
